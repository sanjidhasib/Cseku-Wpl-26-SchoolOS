# =============================================================================
# SchoolOS Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file.
# =============================================================================

# --- Server ---
PORT=5000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/schoolos

# --- JWT Authentication ---
JWT_SECRET=your_jwt_secret_key_here

# =============================================================================
# AI Tutor Configuration (Week 3)
# =============================================================================

# AI Provider: "gemini" (default) | "openai" (future)
AI_PROVIDER=gemini

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1 million tokens/day
AI_API_KEY=your_gemini_api_key_here

# Gemini model to use
# Recommended: gemini-1.5-flash (fast, cheap, multilingual)
# Alternative: gemini-1.5-pro (higher quality, slower)
AI_MODEL=gemini-1.5-flash
